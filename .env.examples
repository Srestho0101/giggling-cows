# ======================
# Database
# ======================
# Local SQLite (quick start)
# DATABASE_URL=sqlite+aiosqlite:///./cow_farm.db

# Supabase Postgres (Transaction pooler recommended)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ======================
# Supabase Auth
# ======================
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_JWT_ALGORITHM=HS256

# ======================
# App
# ======================
DEBUG=True
